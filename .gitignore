# Data — NO generated data artifacts are tracked, at any size.
#
# The dataset is reproducible-from-code: run the deterministic generator (fixed
# seed 1729) to materialise it locally, then ingest from that output or from a
# Databricks Volume. Nothing downstream reads from committed bytes.
#
#   python -m datagen --sample-frac 0.004 --months 18 --out data/sample \
#       --format parquet --no-partitions       # small, ~7s
#   python -m datagen --out data/full          # full 50k users / ~15.3M rows
#
# Execution evidence lives as committed TEXT under evidence/ (row counts,
# head() previews, per-table digests, two-run reproducibility proof), so the
# proof travels with the repo without any binary artifacts.
/data/
*.csv
*.parquet
*.xlsx
*.db

# Credentials / secrets
.env
*.pem
*.key
.databrickscfg
**/secrets*

# Databricks Asset Bundle state
.databricks/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
