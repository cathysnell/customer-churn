# Local development env. In Databricks Apps these are injected by the runtime
# (host + OAuth token) or declared in app.yaml / app resources. Copy to `.env`.

# --- Databricks workspace (warehouse reads + Genie) ---
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...                       # PAT for local; OAuth SP token in Apps
DATABRICKS_WAREHOUSE_ID=128c306447d9ef00       # same warehouse as the metric views
GENIE_SPACE_ID=01f1ad360e121f099e3070de938cd8cb
DATA_CATALOG=dev_churn

# --- Lakebase Postgres (the "do this now" queue; optional) ---
# If unset, the do-now queue falls back to the SQL warehouse.
LAKEBASE_HOST=
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_USER=
LAKEBASE_PASSWORD=
LAKEBASE_SSL=true

# --- Server ---
PORT=8000
